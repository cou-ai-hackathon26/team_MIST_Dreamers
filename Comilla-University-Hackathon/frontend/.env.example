# Copy this file to frontend/.env (git-ignored). Vite reads only variables that start with VITE_.
# Backend address. Change the port here if the API runs on another one.
VITE_API_URL=http://localhost:8000
# The admin dashboard (/admin) asks for the admin password at sign-in. Never put it in this file:
# every VITE_ variable is built into the app that browsers download.
